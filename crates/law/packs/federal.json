{
  "schema": 1,
  "id": "federal",
  "name": "Federal citation forms",
  "jurisdiction": "Federal",
  "effective": "2024-01-01",
  "rules": [
    {
      "id": "usReporter",
      "kind": "case",
      "source": "Bluebook R. 10.4 (U.S. Reports)",
      "detect": "\\b\\d+\\s+U\\.S\\.\\s+\\d+",
      "valid": "^\\d+\\s+U\\.S\\.\\s+\\d+(?:\\s*,\\s*\\d+)?(?:\\s*\\([^)]+\\))?$",
      "message": "U.S. Reports citations use U.S. with periods and usually include a year parenthetical."
    },
    {
      "id": "sCtReporter",
      "kind": "case",
      "source": "Bluebook R. 10.4 (Supreme Court Reporter)",
      "detect": "\\b\\d+\\s+S\\.\\s*Ct\\.\\s+\\d+",
      "valid": "^\\d+\\s+S\\.\\s*Ct\\.\\s+\\d+(?:\\s*,\\s*\\d+)?(?:\\s*\\([^)]+\\))?$",
      "message": "Supreme Court Reporter citations use S. Ct. with a space after S."
    },
    {
      "id": "federalReporterWrong",
      "kind": "case",
      "source": "Bluebook R. 10.4 (Federal Reporters)",
      "detect": "\\b\\d+\\s+F(?:2d|3d|4th)\\s+\\d+",
      "message": "Use F.2d, F.3d, or F.4th (with a period after F)."
    },
    {
      "id": "federalCourtParen",
      "kind": "case",
      "source": "Bluebook R. 10.4 (court parenthetical)",
      "detect": "\\b\\d+\\s+F\\.(?:2d|3d|4th| Supp\\. (?:2d|3d))\\s+\\d+(?:\\s*$|\\s+[^(])",
      "message": "Federal appellate and district reporter citations need a court parenthetical with the year, e.g. (8th Cir. 2009)."
    },
    {
      "id": "uscSection",
      "kind": "statute",
      "source": "Bluebook R. 12 (U.S.C.)",
      "detect": "\\b\\d+\\s+U\\.S\\.C\\.\\s*§?\\s*\\d+",
      "valid": "^\\d+\\s+U\\.S\\.C\\.\\s*§\\s*\\d+[\\w.-]*$",
      "message": "U.S. Code citations use title, U.S.C., and the section symbol, e.g. 42 U.S.C. § 1983."
    },
    {
      "id": "fedRuleApp",
      "kind": "rule",
      "source": "Bluebook R. 12.9.3 (Federal Rules of Appellate Procedure)",
      "detect": "\\bFed\\.?\\s*R\\.?\\s*App\\.?\\s*P\\.?\\s+\\d+(?:\\([a-z0-9]+\\))*",
      "valid": "^Fed\\.\\s+R\\.\\s+App\\.\\s+P\\.\\s+\\d+(?:\\([a-z0-9]+\\))*$",
      "message": "Federal Rules of Appellate Procedure: Fed. R. App. P. 32(a)."
    },
    {
      "id": "fedRuleCiv",
      "kind": "rule",
      "source": "Bluebook R. 12.9.1 (Federal Rules of Civil Procedure)",
      "detect": "\\bFed\\.?\\s*R\\.?\\s*Civ\\.?\\s*P\\.?\\s+\\d+(?:\\([a-z0-9]+\\))*",
      "valid": "^Fed\\.\\s+R\\.\\s+Civ\\.\\s+P\\.\\s+\\d+(?:\\([a-z0-9]+\\))*$",
      "message": "Federal Rules of Civil Procedure: Fed. R. Civ. P. 12(b)(6)."
    }
  ]
}
