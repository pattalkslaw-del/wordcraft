{
  "schema": 1,
  "id": "missouri",
  "name": "Missouri citation forms",
  "jurisdiction": "Missouri",
  "effective": "2020-01-01",
  "rules": [
    {
      "id": "moCaseReporter",
      "kind": "case",
      "source": "Show Me Citations (reporter spacing)",
      "detect": "\\b\\d+\\s+S\\.\\s+W\\.\\s+(?:2d|3d)\\b",
      "message": "Missouri case reporters use tight spacing: S.W.2d or S.W.3d (not S.W. 2d)."
    },
    {
      "id": "moCaseReporterWrong",
      "kind": "case",
      "source": "Show Me Citations (reporter spacing)",
      "detect": "\\b\\d+\\s+SW(?:2d|3d)\\b",
      "message": "Use S.W.2d or S.W.3d with periods and no space before the series."
    },
    {
      "id": "moCaseParenthetical",
      "kind": "case",
      "source": "Show Me Citations (parenthetical)",
      "detect": "\\bv\\.\\s+[^,]+,\\s*\\d+\\s+S\\.W\\.(?:2d|3d)\\s+\\d+(?:\\s*$|\\s+[^(])",
      "message": "A Missouri case citation with a S.W. reporter needs a court and year parenthetical, e.g. (Mo. banc 1978)."
    },
    {
      "id": "moBancCaps",
      "kind": "case",
      "source": "Show Me Citations (court abbreviations)",
      "detect": "\\(Mo\\.\\s+Banc\\s+\\d{4}\\)",
      "message": "Use lowercase banc: (Mo. banc 1978), not Mo. Banc."
    },
    {
      "id": "moAppDistrict",
      "kind": "case",
      "source": "Show Me Citations (court of appeals districts)",
      "detect": "\\(Mo\\.\\s+App\\.\\s+\\d{4}\\)",
      "message": "Missouri Court of Appeals citations name the district: (Mo. App. E.D. 2020), (Mo. App. W.D. 2019), or (Mo. App. S.D. 2021)."
    },
    {
      "id": "moAppMissingYear",
      "kind": "case",
      "source": "Show Me Citations (parenthetical)",
      "detect": "\\(Mo\\.\\s+App\\.\\s+(?:E\\.D\\.|W\\.D\\.|S\\.D\\.)(?:\\s*\\)|\\s+[^0-9])",
      "message": "The court parenthetical needs a four-digit year after the district."
    },
    {
      "id": "moStatuteForm",
      "kind": "statute",
      "source": "Show Me Citations (statutes)",
      "detect": "\\b(?:Section|Sec\\.|§)\\s*\\d+\\.\\d+[^,\\s]*\\s+RSMo\\b",
      "valid": "^(?:Section|§)\\s*\\d+\\.\\d+(?:,\\s*RSMo(?:\\s+\\d{4})?|(?:\\s+RSMo(?:\\s+\\d{4})?))$",
      "message": "Statute citations use Section or § with the RSMo year when given, e.g. Section 537.080, RSMo 2016 or § 537.080 RSMo."
    },
    {
      "id": "moRuleForm",
      "kind": "rule",
      "source": "Mo. Sup. Ct. R. 84.04",
      "detect": "\\bRule\\s+\\d+\\.\\d+(?:\\([a-z]\\))?",
      "valid": "^Rule\\s+\\d{2}\\.\\d{2}(?:\\([a-z]\\))?$",
      "message": "Supreme Court rule citations use Rule with two-part numbers, e.g. Rule 84.04(d)."
    }
  ]
}
